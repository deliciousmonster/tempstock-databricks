{
 "datasets": [
  {
   "name": "status",
   "displayName": "status",
   "queryLines": [
    "SELECT latest_signal_as_of, latest_agent_as_of, open_incident, post_verified_as_of, guarded_tables, ",
    "audit_problems, last_run_outcome, last_run_route, read_at FROM v_ui_status"
   ]
  },
  {
   "name": "sources",
   "displayName": "sources",
   "queryLines": [
    "SELECT kind, layer, name, at, n, n_bad, state, ",
    "CASE WHEN kind = 'fresh' AND name = 'temp_index_daily' THEN 'latest data day' ",
    "WHEN kind = 'fresh' THEN 'latest known_at' WHEN kind = 'source' THEN 'last landed' ",
    "WHEN state = 'COMPLETED' THEN 'checked' ELSE concat('pipeline update ', coalesce(state, 'unknown')) END AS label ",
    "FROM v_ui_sources WHERE kind <> 'fill_shape' ORDER BY kind, layer, name"
   ]
  },
  {
   "name": "outlook",
   "displayName": "outlook",
   "queryLines": [
    "SELECT target_date, horizon_days, coalesce(shown_action, 'no agent call') AS call, ",
    "signal_action AS model_signal, signal_confidence, forecast_anomaly_c, ",
    "CASE WHEN forecast_anomaly_c IS NOT NULL THEN 'normal' WHEN array_contains(reasons, 'no_normal') ",
    "THEN 'no normal' ELSE 'anomaly not recorded' END AS anomaly_basis, ",
    "downgrade_reason, coalesce(run_outcome, 'no run recorded') AS run_outcome, ",
    "coalesce(audit_problem, 'none') AS audit, written_at FROM v_ui_outlook ORDER BY horizon_days"
   ]
  },
  {
   "name": "close",
   "displayName": "close",
   "queryLines": [
    "SELECT date, close FROM v_ui_index WHERE close IS NOT NULL ORDER BY date"
   ]
  },
  {
   "name": "anomaly_monthly",
   "displayName": "anomaly_monthly",
   "queryLines": [
    "WITH m AS (SELECT explode(sequence(date_trunc('MONTH', min(date)), date_trunc('MONTH', max(date)), ",
    "INTERVAL 1 MONTH)) AS month FROM v_ui_index WHERE index_c IS NOT NULL), ",
    "a AS (SELECT date_trunc('MONTH', date) AS month, avg(anomaly_c) AS anomaly_c FROM v_ui_index GROUP BY 1) ",
    "SELECT m.month, a.anomaly_c FROM m LEFT JOIN a ON a.month = m.month ORDER BY m.month"
   ]
  },
  {
   "name": "history_calls",
   "displayName": "history_calls",
   "queryLines": [
    "SELECT target_date, coalesce(shown_action, 'no agent call') AS call, signal_action AS model_signal, ",
    "source, coalesce(audit_problem, 'none') AS audit, last_close FROM v_ui_calls WHERE horizon_days = 0 ",
    "QUALIFY row_number() OVER (PARTITION BY target_date ORDER BY as_of DESC) = 1 ORDER BY target_date DESC"
   ]
  },
  {
   "name": "firmed",
   "displayName": "firmed",
   "queryLines": [
    "SELECT target_date, horizon_days, coalesce(max_by(shown_action, as_of), 'no agent call') AS call, ",
    "max_by(signal_action, as_of) AS model_signal FROM v_ui_calls ",
    "WHERE target_date >= current_date() - 30 GROUP BY ALL ORDER BY target_date DESC, horizon_days DESC"
   ]
  },
  {
   "name": "firmed_changed",
   "displayName": "firmed_changed",
   "queryLines": [
    "SELECT count_if(a6 <> a0) AS changed, count(*) AS dates FROM (SELECT target_date, ",
    "max_by(shown_action, as_of) FILTER (WHERE horizon_days = 6) AS a6, ",
    "max_by(shown_action, as_of) FILTER (WHERE horizon_days = 0) AS a0 FROM v_ui_calls GROUP BY target_date) ",
    "WHERE a6 IS NOT NULL AND a0 IS NOT NULL"
   ]
  },
  {
   "name": "runs_daily",
   "displayName": "runs_daily",
   "queryLines": [
    "SELECT date(started_at) AS day, coalesce(outcome, 'unknown') AS outcome, count(*) AS runs ",
    "FROM v_ui_agent_runs GROUP BY ALL ORDER BY day"
   ]
  },
  {
   "name": "routes",
   "displayName": "routes",
   "queryLines": [
    "SELECT coalesce(route, 'unknown') AS route, count(*) AS runs FROM v_ui_agent_runs GROUP BY 1"
   ]
  },
  {
   "name": "durations",
   "displayName": "durations",
   "queryLines": [
    "SELECT percentile(duration_s, 0.5) AS p50_s, max(duration_s) AS max_s, count(*) AS runs FROM v_ui_agent_runs"
   ]
  },
  {
   "name": "audit",
   "displayName": "audit",
   "queryLines": [
    "SELECT as_of, target_date, signal_action AS model_signal, agent_action, audit_problem FROM v_ui_calls ",
    "WHERE audit_problem IS NOT NULL ORDER BY as_of DESC"
   ]
  },
  {
   "name": "intraday_chart",
   "displayName": "intraday_chart",
   "queryLines": [
    "WITH bars AS (SELECT bar_start, close FROM v_ui_intraday), ",
    "sess AS (SELECT to_date(bar_start) AS d, min(bar_start) AS opened, max(session_close) AS closed FROM v_ui_intraday GROUP BY 1), ",
    "calls AS (SELECT c.* FROM v_ui_calls c JOIN sess s ON to_date(c.as_of) = s.d ",
    "AND c.as_of BETWEEN s.opened AND s.closed + INTERVAL 1 HOUR WHERE c.horizon_days = 0) ",
    "SELECT bar_start AS at, close AS price, 'hourly close' AS series FROM bars ",
    "UNION ALL SELECT c.as_of, max_by(b.close, b.bar_start), ",
    "concat(coalesce(c.shown_action, c.signal_action), ' call') ",
    "FROM calls c JOIN bars b ON b.bar_start < c.as_of GROUP BY c.as_of, c.shown_action, c.signal_action ",
    "UNION ALL SELECT as_of, est_price, 'est_price' FROM calls WHERE est_price IS NOT NULL ",
    "ORDER BY at"
   ]
  },
  {
   "name": "intraday_calls",
   "displayName": "intraday_calls",
   "queryLines": [
    "WITH bars AS (SELECT bar_start, close FROM v_ui_intraday), ",
    "sess AS (SELECT to_date(bar_start) AS d, min(bar_start) AS opened, max(session_close) AS closed FROM v_ui_intraday GROUP BY 1), ",
    "calls AS (SELECT c.* FROM v_ui_calls c JOIN sess s ON to_date(c.as_of) = s.d ",
    "AND c.as_of BETWEEN s.opened AND s.closed + INTERVAL 1 HOUR WHERE c.horizon_days = 0) ",
    "SELECT as_of, target_date, coalesce(shown_action, 'no agent call') AS call, ",
    "signal_action AS model_signal, last_close, ",
    "CASE WHEN est_price IS NOT NULL THEN format_number(est_price, 2) ",
    "ELSE concat_ws(' ', '-', est_reason) END AS est_price ",
    "FROM calls ORDER BY as_of DESC"
   ]
  }
 ],
